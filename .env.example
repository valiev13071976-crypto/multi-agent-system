# =========================
# OpenAI
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# =========================
# Anthropic
# =========================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =========================
# xAI (Grok)
# =========================
XAI_API_KEY=
XAI_MODEL=grok-4

# =========================
# Google Gemini
# =========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# =========================
# DeepSeek
# =========================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# =========================
# Auto provider routing (optional)
# =========================
# AUTO_PROVIDER_ORDER=openai,anthropic,gemini,grok,deepseek
# AUTO_CAPABILITY_FALLBACK=general
# AUTO_ROUTING_POLICY=priority
#
# Missing *_TASK_CATEGORIES means the provider supports only: general
# OPENAI_TASK_CATEGORIES=general,strategy
# ANTHROPIC_TASK_CATEGORIES=general,technical
# GEMINI_TASK_CATEGORIES=general
# XAI_TASK_CATEGORIES=general
# DEEPSEEK_TASK_CATEGORIES=general
#
# Optional class metadata. Used by AUTO_ROUTING_POLICY=quality|cost|latency|balanced.
# OPENAI_QUALITY_CLASS=standard
# OPENAI_COST_CLASS=standard
# OPENAI_LATENCY_CLASS=standard
# OPENAI_CONTEXT_CLASS=standard
# OPENAI_SUPPORTS_TOOLS=false
# OPENAI_SUPPORTS_VISION=false
# OPENAI_SUPPORTS_STRUCTURED_OUTPUT=false

# =========================
# Encryption (optional until EncryptionService is used)
# =========================
# 32-byte AES-256-GCM key, urlsafe base64. Never commit a real value.
# PANDA_ENCRYPTION_KEY=
# PANDA_ENCRYPTION_KEY_ID=v1

# =========================
# FinOps pricing / budgets (optional)
# =========================
# Prices are USD per 1,000,000 tokens. Leave empty = unknown cost.
# OPENAI_INPUT_PRICE_PER_MILLION=
# OPENAI_OUTPUT_PRICE_PER_MILLION=
# OPENAI_PRICE_CURRENCY=USD
# FINOPS_PER_TASK_LIMIT=
# FINOPS_PER_DAY_LIMIT=
# FINOPS_PER_MONTH_LIMIT=
# FINOPS_UNKNOWN_COST_POLICY=allow
# Advanced Budget Guardrails (optional; default disabled)
# FINOPS_BUDGET_GUARD_ENABLED=false
# FINOPS_GLOBAL_LIMIT=
# FINOPS_PER_AGENT_LIMIT=
# FINOPS_PER_PROVIDER_LIMIT=
# FINOPS_PER_MODEL_LIMIT=
# FINOPS_SOFT_LIMIT=
# FINOPS_DEGRADE_THRESHOLD=

# =========================
# External search / Tool Gateway (optional)
# =========================
# Default is a Null adapter. Do not set a paid vendor here.
# SEARCH_PROVIDER=null
# SEARCH_API_KEY=
# TOOL_SEARCH_TIMEOUT_SECONDS=5
# FACT_TRUSTED_DOMAINS=wikipedia.org,who.int,nih.gov,oecd.org

# =========================
# Task Queue (foundation only; /api/analyze stays synchronous)
# =========================
# TASK_QUEUE_MAX_ATTEMPTS=1
# TASK_QUEUE_BASE_RETRY_DELAY_SECONDS=5
# TASK_QUEUE_MAX_RETRY_DELAY_SECONDS=60
# TASK_QUEUE_BACKOFF_MODE=fixed
# TASK_QUEUE_DEFAULT_TIMEOUT_SECONDS=

# =========================
# Autonomy / capability token signing (foundation only)
# =========================
# HMAC-SHA256 key via SecretStore. Never commit a real value.
# PANDA_CAPABILITY_SIGNING_KEY=

# =========================
# HITL (internal runtime; no public approval HTTP API)
# =========================
# HITL_DEFAULT_APPROVAL_TTL_SECONDS=3600
# HITL_EXECUTION_PERMIT_TTL_SECONDS=300

# =========================
# Side-effect durable persistence (optional)
# =========================
# memory (default) or sqlite. Real GitHub writes should use sqlite.
# SIDE_EFFECT_PERSISTENCE_BACKEND=memory
# SIDE_EFFECT_DB_PATH=./data/side_effects.sqlite3
# Local-only recovery candidate scan on compose (no network).
# SIDE_EFFECT_RECOVERY_SCAN_ON_STARTUP=true

# =========================
# Failure Recovery Orchestration (P12; internal only; no public API)
# =========================
# RECOVERY_ORCHESTRATION_ENABLED=true
# RECOVERY_MAX_READ_CHECKS=3
# RECOVERY_BASE_BACKOFF_SECONDS=5
# RECOVERY_MAX_BACKOFF_SECONDS=60
# Optional override only. Normal sqlite production reuses SIDE_EFFECT_DB_PATH
# via the shared P7 SqliteConnection (no second long-lived connection).
# Set RECOVERY_DB_PATH only for an explicit dedicated recovery database file.
# RECOVERY_DB_PATH=

# =========================
# Observability (in-process only; no public exporters in P9)
# =========================
# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_MAX_EVENTS=1000
# OBSERVABILITY_MAX_EVENT_BYTES=4096
# OBSERVABILITY_RECENT_ERRORS=100

# =========================
# GitHub issue label write adapter (disabled by default)
# =========================
# Minimum token permission: Issues Read and write. Do not grant Contents write.
# Adapter is not registered unless ENABLED=true AND allowlist is non-empty AND token exists.
# PROBE_ON_STARTUP, if true, only GET /repos/{owner}/{repo}. Never mutates labels.
GITHUB_WRITE_ADAPTER_ENABLED=false
GITHUB_WRITE_DRY_RUN=true
GITHUB_WRITE_KILL_SWITCH=true
GITHUB_WRITE_PROBE_ON_STARTUP=false
GITHUB_WRITE_REQUIRE_PROBE_SUCCESS=true
GITHUB_WRITE_READINESS_TTL_SECONDS=300
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_WRITE_TIMEOUT_SECONDS=15
GITHUB_WRITE_TOKEN=


