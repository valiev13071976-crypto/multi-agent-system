# =========================
# OpenAI
# =========================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# =========================
# Anthropic
# =========================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# =========================
# xAI (Grok)
# =========================
XAI_API_KEY=
XAI_MODEL=grok-4

# =========================
# Google Gemini
# =========================
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# =========================
# DeepSeek
# =========================
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# =========================
# Moonshot / Kimi (disabled by default)
# =========================
# Official OpenAI-compatible API: https://api.moonshot.ai/v1 (or api.moonshot.cn/v1)
# Model IDs are config-driven — set explicitly from current Moonshot docs (e.g. kimi-k3).
# Do NOT paste real API keys into the repository. Use SecretStore / local env only.
# MOONSHOT_ENABLED=false
# MOONSHOT_API_KEY=
# MOONSHOT_DEFAULT_MODEL=
# MOONSHOT_BASE_URL=https://api.moonshot.ai/v1
# MOONSHOT_TIMEOUT_SECONDS=120
# MOONSHOT_LIVE_EVAL_ENABLED=false
# Pricing: leave unset / unknown unless officially verified (unknown != zero).
# MOONSHOT_PRICE_STATUS=unknown
# MOONSHOT_INPUT_PRICE_PER_MILLION=
# MOONSHOT_OUTPUT_PRICE_PER_MILLION=

# =========================
# Mistral AI (disabled by default)
# =========================
# Official OpenAI-compatible API: https://api.mistral.ai/v1
# Auth: Authorization Bearer MISTRAL_API_KEY
# Chat: POST /v1/chat/completions | Models: GET /v1/models
# Model IDs are config-driven — set explicitly from current Mistral docs.
# Recommended general: mistral-large-latest
# Recommended coding: codestral-latest
# Also documented: mistral-medium-latest, mistral-small-latest
# Do NOT paste real API keys into the repository. Use SecretStore / local env only.
# MISTRAL_ENABLED=false
# MISTRAL_API_KEY=
# MISTRAL_DEFAULT_MODEL=
# MISTRAL_BASE_URL=https://api.mistral.ai/v1
# MISTRAL_TIMEOUT_SECONDS=120
# Do not set MISTRAL_TEMPERATURE unless explicitly required; omit by default.
# MISTRAL_TEMPERATURE=
# MISTRAL_LIVE_EVAL_ENABLED=false
# Pricing: leave unset / unknown unless officially verified (unknown != zero).
# MISTRAL_PRICE_STATUS=unknown
# MISTRAL_INPUT_PRICE_PER_MILLION=
# MISTRAL_OUTPUT_PRICE_PER_MILLION=

# =========================
# Auto provider routing (optional)
# =========================
# AUTO_PROVIDER_ORDER=openai,anthropic,gemini,grok,deepseek,moonshot,mistral

# Dynamic provider health gate for mode=auto (process-local; not shared across workers)
# ROUTING_HEALTH_ENABLED=true
# ROUTING_HEALTH_WINDOW_SECONDS=300
# ROUTING_HEALTH_FAILURE_THRESHOLD=3
# ROUTING_HEALTH_COOLDOWN_SECONDS=60

# Runtime Quality/Latency/Cost stats (process-local; tie-break OFF by default)
# ROUTING_RUNTIME_STATS_WINDOW_SECONDS=900
# ROUTING_RUNTIME_STATS_MIN_SAMPLES=5
# ROUTING_RUNTIME_STATS_MAX_SAMPLES=200
# ROUTING_RUNTIME_TIEBREAK_ENABLED=false
# AUTO_CAPABILITY_FALLBACK=general
# AUTO_ROUTING_POLICY=priority
#
# Missing *_TASK_CATEGORIES uses provider defaults:
#   openai/anthropic/gemini/deepseek → general,strategy,critique
#   grok → general,strategy,critique,trend_analysis
#   moonshot/mistral → general
# OPENAI_TASK_CATEGORIES=general,strategy,critique
# ANTHROPIC_TASK_CATEGORIES=general,strategy,critique
# GEMINI_TASK_CATEGORIES=general,strategy,critique
# XAI_TASK_CATEGORIES=general,strategy,critique,trend_analysis
# DEEPSEEK_TASK_CATEGORIES=general,strategy,critique
# MOONSHOT_TASK_CATEGORIES=general,research,technical
# MISTRAL_TASK_CATEGORIES=general,research,technical
#
# Optional class metadata. Used by AUTO_ROUTING_POLICY=quality|cost|latency|balanced.
# OPENAI_QUALITY_CLASS=standard
# OPENAI_COST_CLASS=standard
# OPENAI_LATENCY_CLASS=standard
# OPENAI_CONTEXT_CLASS=standard
# OPENAI_SUPPORTS_TOOLS=false
# OPENAI_SUPPORTS_VISION=false
# OPENAI_SUPPORTS_STRUCTURED_OUTPUT=false
# When unset, supports_reasoning is inferred True iff task_categories include
# strategy or critique. Set explicitly to override:
# OPENAI_SUPPORTS_REASONING=true
# OPENAI_SUPPORTS_REASONING=false

# =========================
# Encryption (optional until EncryptionService is used)
# =========================
# 32-byte AES-256-GCM key, urlsafe base64. Never commit a real value.
# PANDA_ENCRYPTION_KEY=
# PANDA_ENCRYPTION_KEY_ID=v1

# =========================
# FinOps pricing / budgets (optional)
# =========================
# Prices are USD per 1,000,000 tokens. Leave empty = unknown cost.
# OPENAI_INPUT_PRICE_PER_MILLION=
# OPENAI_OUTPUT_PRICE_PER_MILLION=
# OPENAI_PRICE_CURRENCY=USD
# FINOPS_PER_TASK_LIMIT=
# FINOPS_PER_DAY_LIMIT=
# FINOPS_PER_MONTH_LIMIT=
# FINOPS_UNKNOWN_COST_POLICY=allow
# Advanced Budget Guardrails (optional; default disabled)
# FINOPS_BUDGET_GUARD_ENABLED=false
# FINOPS_GLOBAL_LIMIT=
# FINOPS_PER_AGENT_LIMIT=
# FINOPS_PER_PROVIDER_LIMIT=
# FINOPS_PER_MODEL_LIMIT=
# FINOPS_SOFT_LIMIT=
# FINOPS_DEGRADE_THRESHOLD=

# =========================
# External search / Tool Gateway (optional)
# =========================
# Default is a Null adapter. Do not set a paid vendor here.
# SEARCH_PROVIDER=null
# SEARCH_API_KEY=
# TOOL_SEARCH_TIMEOUT_SECONDS=5
# FACT_TRUSTED_DOMAINS=wikipedia.org,who.int,nih.gov,oecd.org

# =========================
# Task Queue (foundation only; /api/analyze stays synchronous)
# =========================
# TASK_QUEUE_MAX_ATTEMPTS=1
# TASK_QUEUE_BASE_RETRY_DELAY_SECONDS=5
# TASK_QUEUE_MAX_RETRY_DELAY_SECONDS=60
# TASK_QUEUE_BACKOFF_MODE=fixed
# TASK_QUEUE_DEFAULT_TIMEOUT_SECONDS=

# =========================
# Autonomy / capability token signing (foundation only)
# =========================
# HMAC-SHA256 key via SecretStore. Never commit a real value.
# PANDA_CAPABILITY_SIGNING_KEY=

# =========================
# HITL (internal runtime; no public approval HTTP API)
# =========================
# HITL_DEFAULT_APPROVAL_TTL_SECONDS=3600
# HITL_EXECUTION_PERMIT_TTL_SECONDS=300

# =========================
# Side-effect durable persistence (optional)
# =========================
# memory (default) or sqlite. Real GitHub writes should use sqlite.
# SIDE_EFFECT_PERSISTENCE_BACKEND=memory
# SIDE_EFFECT_DB_PATH=./data/side_effects.sqlite3
# Local-only recovery candidate scan on compose (no network).
# SIDE_EFFECT_RECOVERY_SCAN_ON_STARTUP=true

# =========================
# Failure Recovery Orchestration (P12; internal only; no public API)
# =========================
# RECOVERY_ORCHESTRATION_ENABLED=true
# RECOVERY_MAX_READ_CHECKS=3
# RECOVERY_BASE_BACKOFF_SECONDS=5
# RECOVERY_MAX_BACKOFF_SECONDS=60
# Optional override only. Normal sqlite production reuses SIDE_EFFECT_DB_PATH
# via the shared P7 SqliteConnection (no second long-lived connection).
# Set RECOVERY_DB_PATH only for an explicit dedicated recovery database file.
# RECOVERY_DB_PATH=

# =========================
# Memory / Knowledge (P13; internal only; no public API; no external vector DB)
# =========================
# MEMORY_ENABLED=true
# MEMORY_BACKEND=memory
# Dedicated sqlite file when MEMORY_BACKEND=sqlite. Leave unset to reuse the
# shared P7 SqliteConnection when durable side-effect persistence is active.
# MEMORY_DB_PATH=
# MEMORY_MAX_RECORD_BYTES=32768
# MEMORY_DEFAULT_EPISODIC_TTL_DAYS=90
# MEMORY_WORKING_REFERENCE_TTL_HOURS=24

# =========================
# Documents / Spreadsheets (P14; internal only; no public API; no cloud office)
# =========================
# DOCUMENTS_ENABLED=true
# DOCUMENT_BACKEND=memory
# Dedicated sqlite file when DOCUMENT_BACKEND=sqlite. Leave unset to reuse the
# shared P7 SqliteConnection when durable side-effect persistence is active.
# DOCUMENT_DB_PATH=
# DOCUMENT_MAX_FILE_BYTES=5000000
# DOCUMENT_MAX_TEXT_BYTES=1000000
# DOCUMENT_MAX_TABLE_CELLS=100000
# DOCUMENT_MAX_PAGES=200
# DOCUMENT_MAX_SHEETS=50
# DOCUMENT_MAX_CHUNKS=500
# DOCUMENT_CHUNK_MAX_CHARS=2000
# DOCUMENT_CHUNK_OVERLAP_CHARS=100

# =========================
# External Knowledge / RAG (P15; internal only; no public API; no vector DB)
# =========================
# KNOWLEDGE_ENABLED=true
# KNOWLEDGE_MAX_SOURCES=64
# KNOWLEDGE_MAX_RESULTS=10
# KNOWLEDGE_MAX_ITEM_BYTES=32768
# KNOWLEDGE_MAX_CONTEXT_BYTES=64000
# KNOWLEDGE_DEFAULT_TTL_SECONDS=86400

# P16 Procurement MVP (internal only — no public API)
# PROCUREMENT_ENABLED=true
# PROCUREMENT_BACKEND=memory
# PROCUREMENT_DB_PATH=
# PROCUREMENT_MIN_VALID_OFFERS=2
# PROCUREMENT_EXTERNAL_SEARCH_ENABLED=false
# PROCUREMENT_EXTERNAL_MAX_QUERIES=2
# PROCUREMENT_EXTERNAL_MAX_RESULTS=5
# PROCUREMENT_CATALOG_MAX_ITEMS=50
# PROCUREMENT_RFQ_DRAFT_MAX_CHARS=8000
# PROCUREMENT_EXTERNAL_TIMEOUT_SECONDS=10

# =========================
# Security / API authentication (P17)
# =========================
# SECURITY_AUTH_MODE=disabled   # dev/test only
# SECURITY_AUTH_MODE=required   # production (default when PANDA_ENV=production)
# PANDA_API_KEYS=key-a|tenant-a|user-a|user,operator|secret;key-b|tenant-b|user-b|user|secret2
# SECURITY_DEFAULT_TENANT=legacy-default
# SECURITY_RATE_LIMIT_USER_PER_MIN=120
# SECURITY_RATE_LIMIT_TENANT_PER_MIN=600
# SECURITY_RATE_LIMIT_IP_PER_MIN=30
# SECURITY_RATE_LIMIT_HEALTH_PER_MIN=300
# SECURITY_CORS_ORIGINS=https://app.example.com
# SECURITY_MAX_REQUEST_BODY_BYTES=65536

# OBSERVABILITY_ENABLED=true
# OBSERVABILITY_MAX_EVENTS=1000
# OBSERVABILITY_MAX_EVENT_BYTES=4096
# OBSERVABILITY_RECENT_ERRORS=100

# =========================
# GitHub issue label write adapter (disabled by default)
# =========================
# Minimum token permission: Issues Read and write. Do not grant Contents write.
# Adapter is not registered unless ENABLED=true AND allowlist is non-empty AND token exists.
# PROBE_ON_STARTUP, if true, only GET /repos/{owner}/{repo}. Never mutates labels.
GITHUB_WRITE_ADAPTER_ENABLED=false
GITHUB_WRITE_DRY_RUN=true
GITHUB_WRITE_KILL_SWITCH=true
GITHUB_WRITE_PROBE_ON_STARTUP=false
GITHUB_WRITE_REQUIRE_PROBE_SUCCESS=true
GITHUB_WRITE_READINESS_TTL_SECONDS=300
GITHUB_ALLOWED_REPOSITORIES=
GITHUB_WRITE_TIMEOUT_SECONDS=15
GITHUB_WRITE_TOKEN=

# =========================
# =========================
# Stage 1 — Production Foundation
# =========================
# PANDA_ENV=development  # development | test | production
# PANDA_DATA_DIR=/data   # Railway persistent volume mount (production REQUIRED)
# PANDA_ARTIFACT_ROOT=   # defaults to $PANDA_DATA_DIR/artifacts
# PANDA_BACKUP_ROOT=     # defaults to $PANDA_DATA_DIR/backups
# PANDA_BACKUP_DESTINATION=local
# PANDA_BACKUP_STALE_HOURS=26
# PANDA_DISK_FREE_THRESHOLD_BYTES=104857600
# PANDA_ALERT_WEBHOOK_URL=
# PUBLIC_URL=https://your-app.example.com

# PANDA_RUNTIME_PROFILE=development  # development | single-node-production | multi-process-production
# WORKER_LEASE_SECONDS=300
# WORKER_HEARTBEAT_INTERVAL_SECONDS=30   # must be < lease
# WORKER_POLL_INTERVAL_SECONDS=0.25
# SCHEDULE_CLAIM_LEASE_SECONDS=120
# Phase 3 runtime roles / capacity (Block 1)
# =========================
# RUNTIME_ROLE=combined   # api | worker | combined
# WORKFLOW_WORKER_ENABLED=true  # false → API-only (legacy alias)
# MAX_PENDING_GLOBAL=1000
# MAX_PENDING_PER_TENANT=100
# MAX_RUNNING_GLOBAL=100
# MAX_RUNNING_PER_TENANT=20
# MAX_QUEUE_AGE_SECONDS=
# FINOPS_BUDGET_DB_PATH=   # optional; defaults to SIDE_EFFECT_DB_PATH when wired

# =========================
# Phase 3 Block 2 — lanes / fairness / provider governor
# =========================
# WORKER_LANES=all   # all | interactive | background,bulk,scheduled | normal(=background)
# WORKER_POOL=normal  # interactive | normal | batch  (maps lanes: ix / background / bulk+scheduled)
# LARGE_EXCEL_ROWS=100000   # estimated_rows threshold → batch workload
# LARGE_DATA_BYTES=52428800 # 50MB estimated_bytes threshold → batch workload
# CANARY: use evals.CanaryController (percent 0-100); disable() is immediate; rollback via RoutingActivationService
# INTERACTIVE_RESERVED=5
# INTERACTIVE_PENDING_RESERVE=50
# BACKGROUND_MAY_BORROW_INTERACTIVE=true
# PRIORITY_AGING_SECONDS=60
# PRIORITY_AGING_MAX_BOOST=2
# TENANT_FAIRNESS_ENABLED=true
# MAX_BATCH_PENDING_PER_TENANT=  # optional tenant batch/bulk pending cap
# ROUTING_HEALTH_DB_PATH=   # optional shared routing health; defaults to SIDE_EFFECT_DB_PATH
# PROVIDER_GOVERNOR_ENABLED=true
# PROVIDER_MAX_CONCURRENCY=8
# PROVIDER_INTERACTIVE_RESERVED=2
# PROVIDER_BACKGROUND_MAY_BORROW=true
# PROVIDER_MAX_RPM=120
# PROVIDER_MAX_QPS=20
# PROVIDER_MAX_TPM=   # optional tokens/min; empty/disabled by default
# PROVIDER_BREAKER_FAILURE_THRESHOLD=5
# PROVIDER_BREAKER_COOLDOWN_SECONDS=30
# PROVIDER_BREAKER_HALF_OPEN_PROBES=1
# PROVIDER_SLOT_TTL_SECONDS=120
# PROVIDER_GOVERNOR_DB_PATH=   # optional; defaults to SIDE_EFFECT_DB_PATH

# =========================
# Stage 2 — Live Integrations (production adapters)
# =========================
# PRODUCTION_INTEGRATIONS_ENABLED=true
# SAAS_BILLING_PROVIDER=fake          # fake | stripe (fake forbidden in production when billing enabled)
# SAAS_BILLING_MODE=test              # test | live
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# SAAS_BILLING_WEBHOOK_SECRET=
# TELEGRAM_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# EMAIL_ENABLED=false
# EMAIL_API_KEY=
# EMAIL_FROM_ADDRESS=
# SPEECH_PROVIDER=fake                # fake | openai
# SPEECH_API_KEY=
# SPEECH_STT_MODEL=whisper-1
# SPEECH_TTS_MODEL=tts-1
# SEO_PRODUCTION_ENABLED=false
# GSC_PROPERTY_ID=sc-domain:example.com
# GA4_PROPERTY_ID=properties/000000
# GOOGLE_SERVICE_ACCOUNT_JSON=
# MEDIA_IMAGE_PROVIDER=fake           # fake | openai
# MEDIA_IMAGE_API_KEY=
# MEDIA_IMAGE_MODEL=dall-e-2
# MEDIA_VIDEO_ENABLED=false
# COMMERCE_INTEGRATIONS_ENABLED=true
# BITRIX_ENABLED=false
# BITRIX_WEBHOOK_URL=
# ONEC_API_URL=
# ONEC_API_TOKEN=

